# Copia este archivo a .env en la raíz del repo (junto a docker-compose.yml)
# y completa los valores. Este único .env alimenta TODO el stack de Docker
# Compose: las variables de nginx/certbot/mysql para armar los contenedores,
# Y las variables de Laravel (se inyectan directo como env vars del
# contenedor `app`, sin necesitar un backend/.env dentro de la imagen).

# ===== Nginx + Let's Encrypt (Certbot) =====
# El dominio DEBE apuntar (DNS tipo A) a la IP del VPS antes de correr deploy.sh,
# o Let's Encrypt no podrá validar el certificado.
DOMAIN=tu-dominio.com
CERTBOT_EMAIL=tu-email@tu-dominio.com

# ===== Laravel =====
APP_NAME=Logix
APP_ENV=production
# Vacío a propósito: deploy.sh genera un APP_KEY real la primera vez que corre.
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.com
FRONTEND_URL=https://tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ===== Base de datos (contenedor `db` de este mismo compose, MySQL 8.4) =====
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=logix
DB_USERNAME=logix
DB_PASSWORD=cambia-esta-clave
# Solo la usa el contenedor db para inicializarse (usuario root de MySQL).
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Detrás de nginx con TLS: las cookies de sesión solo viajan por HTTPS.
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# ===== Correo (SMTP real — factura/recibos se envían por CorreoLogix) =====
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=facturacion@tu-dominio.com
MAIL_FROM_NAME="${APP_NAME}"

# ===== Cloudinary (imágenes: perfil, logos, galería) =====
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ===== Pasarela de pagos Wompi =====
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_REDIRECT_URL=
