# Configuración de PRODUCCIÓN para el build dentro del monolito (backend/Dockerfile):
# frontend y backend se sirven desde el mismo dominio (fenixpos.lat), así que
# VITE_API_URL queda vacío a propósito -> el cliente usa rutas relativas /api/*
# contra el propio origen (ver src/api/client.js). Antes este proyecto vivía
# separado en Vercel (frontend) + Render (backend); ya no aplica.
VITE_API_URL=

# URL pública para enlaces/QR de reservas. Vacío = usa el origen actual.
VITE_PUBLIC_URL=
