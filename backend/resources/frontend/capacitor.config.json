{
  "appId": "com.fenixpos.app",
  "appName": "Fénix",
  "webDir": "../../public/build",
  "backgroundColor": "#0f172a",
  "server": {
    "url": "https://fenixpos.lat",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0f172aff",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
